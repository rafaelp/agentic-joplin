{
  "name": "@rafaelp/agentic-joplin",
  "version": "0.2.0",
  "description": "Keep the Joplin CLI in sync on macOS: a launchd agent with overlap protection, log rotation and failure notifications",
  "keywords": [
    "joplin",
    "sync",
    "launchd",
    "macos",
    "e2ee"
  ],
  "license": "MIT",
  "author": "Rafael Lima",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelp/agentic-joplin.git"
  },
  "homepage": "https://github.com/rafaelp/agentic-joplin#readme",
  "bugs": "https://github.com/rafaelp/agentic-joplin/issues",
  "type": "module",
  "bin": {
    "agentic-joplin": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc",
    "sync": "node src/cli.ts sync",
    "agent:install": "node src/cli.ts install",
    "agent:uninstall": "node src/cli.ts uninstall",
    "agent:print": "node src/cli.ts print",
    "agent:run": "node src/cli.ts run",
    "status": "node src/cli.ts status",
    "logs": "node src/cli.ts logs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
